# --- Trading 212 API (Parametres > API dans l'app Trading 212) ---
# Restreignez la cle a votre IP et aux seules permissions necessaires.
api_key_id=replace_with_api_key
secret_key=replace_with_secret_key
# https://demo.trading212.com (compte demo) ou https://live.trading212.com (argent reel)
TRADING212_BASE_URL=https://demo.trading212.com

# --- Securite de l'API locale ---
# Jeton exige par le backend (en-tete Authorization: Bearer). Vide = aucune authentification.
# Generer : python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ACCESS_TOKEN=
FRONTEND_ORIGIN=http://localhost:5173

# --- Garde-fous ordres et bot ---
MIN_ORDER_QUANTITY=0.0001
MAX_ORDER_QUANTITY=50
BOT_DEFAULT_POLL_INTERVAL_SECONDS=45
BOT_MAX_TICKERS=12
